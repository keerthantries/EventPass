NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

MONGO_URI=mongodb://localhost:27017/eventpass

JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES=30d

BCRYPT_SALT_ROUNDS=12

CLIENT_URL=http://localhost:3000

# Optional file storage (local disk fallback used if not set)
UPLOAD_DIR=uploads
QR_DIR=uploads/qr
